# Copy thành .env rồi điền giá trị thật
OPEN_NOTEBOOK_ENCRYPTION_KEY=doi-thanh-chuoi-bi-mat-cua-ban
# SURREAL_USER=root
# SURREAL_PASSWORD=root

# --- Tuỳ chọn (bỏ comment nếu cần) ---

# Giới hạn dung lượng upload/request (MB, mặc định 100)
# OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB=100

# Bật mật khẩu bảo vệ instance (auth tắt hoàn toàn nếu để trống)
# OPEN_NOTEBOOK_PASSWORD=mat-khau-cua-ban

# Số task xử lý nền song song (mặc định 5; đặt 1 cho máy 1 GPU / LLM local)
# OPEN_NOTEBOOK_WORKER_MAX_TASKS=1

# YouTube chặn IP server: dùng proxy dân cư hoặc file cookies.txt
# CCORE_YOUTUBE_PROXY=http://user:pass@proxy:8080
# CCORE_YOUTUBE_COOKIES_FILE=/app/data/cookies.txt

# Đi qua proxy công ty (NO_PROXY phải chứa surrealdb, host.docker.internal)
# HTTP_PROXY=http://proxy.corp.com:8080
# HTTPS_PROXY=http://proxy.corp.com:8080
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,surrealdb,.local
